{
  "name": "loadbearing",
  "version": "0.1.0",
  "description": "Profile your CLAUDE.md / AGENTS.md by what it actually costs and what it actually changes — see which sections earn their tokens, with the noise floor shown so you can trust the number.",
  "type": "module",
  "bin": {
    "loadbearing": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude",
    "agents-md",
    "claude-md",
    "anthropic",
    "ai",
    "llm",
    "ai-agents",
    "agent",
    "context",
    "context-engineering",
    "prompt-engineering",
    "tokens",
    "token-optimization",
    "cost",
    "ablation",
    "profiler",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/webcoderspeed/loadbearing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webcoderspeed/loadbearing.git"
  },
  "bugs": {
    "url": "https://github.com/webcoderspeed/loadbearing/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "author": "webcoderspeed"
}
